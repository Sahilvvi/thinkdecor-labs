# Copy this to .env for local development, and add the same keys under
# Vercel → Project → Settings → Environment Variables for deployment.
# All of these are read client-side (import.meta.env.VITE_*), so only put
# values here that are safe to ship in the browser bundle — the Supabase
# anon/publishable key is meant to be public; real secrets (OpenAI key,
# Stripe secret key, Supabase service role key) live in Supabase's own
# Edge Function secrets, never here.

# Required — from Supabase dashboard → Settings → API
VITE_SUPABASE_URL=https://xgeywhbuvpbbzhldtbxj.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional — flips from the placeholder generator to the real
# generate-redesign edge function. Only set to true once OPENAI_API_KEY
# is set as a Supabase Edge Function secret.
VITE_LIVE_GENERATION=true

# Optional — Cloudflare Turnstile site key, enables the signup CAPTCHA.
# Leave unset to keep CAPTCHA off.
VITE_TURNSTILE_SITE_KEY=

# Set to 1 on a test copy of the site (its own Vercel project) so search engines
# don't index it. Leave unset in production.
VITE_SITE_NOINDEX=
